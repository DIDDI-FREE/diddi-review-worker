APP_ENV=development
SERVICE_NAME=diddi-review-runner
DIDDIFREEID_BASE_URL=http://diddi-free-id:8000
DIDDIGO_BASE_URL=http://diddi-go:8000
DIDDISEND_BASE_URL=http://diddi-send:8000
DIDDIFOOD_BASE_URL=http://diddi-food:8000
DIDDIFREEID_ISSUER=https://identity.example.test
DIDDIFREEID_AUDIENCE=diddi-services
DIDDIFREEID_JWKS_URL=http://diddi-free-id:8000/.well-known/jwks.json
JWT_ALGORITHMS=RS256
HTTP_TIMEOUT_SECONDS=15
REDIS_URL=redis://redis:6379/0
STREAM_NAME=diddi-review-runs
DATABASE_URL=postgresql+asyncpg://runner:runner@postgres:5432/review_runner
REVIEW_ACCOUNTS_JSON=[]
DIDDIGO_PASSENGER_USER_ID=
DIDDIGO_PASSENGER_EMAIL=
DIDDIGO_PASSENGER_OTP=
DIDDIGO_DRIVER_USER_ID=
DIDDIGO_DRIVER_EMAIL=
DIDDIGO_DRIVER_OTP=
REACTIVE_ENABLED=false
REACTIVE_POLL_INTERVAL_SECONDS=3
# Default pickup/dropoff for requests the runner creates (defaults: Abidjan).
REQUEST_PICKUP_LAT=5.3599
REQUEST_PICKUP_LNG=-4.0083
REQUEST_PICKUP_ADDRESS=Plateau, Abidjan
REQUEST_DROPOFF_LAT=5.3760
REQUEST_DROPOFF_LNG=-3.9876
REQUEST_DROPOFF_ADDRESS=Cocody, Abidjan
